{
  "name": "warplanet",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.14.0",
    "expo": "~58.0.14",
    "expo-build-properties": "~58.0.11",
    "expo-dev-client": "~58.0.14",
    "expo-font": "~58.0.8",
    "expo-keep-awake": "~58.0.3",
    "expo-network": "~58.0.3",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-tcp-socket": "^6.4.3",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "react-native-zeroconf": "^0.17.6"
  },
  "devDependencies": {
    "@turf/turf": "^7.4.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.3.0",
    "d3-delaunay": "^6.0.4",
    "d3-geo": "^3.1.1",
    "jest": "~29.7.0",
    "jest-expo": "~58.0.11",
    "mapshaper": "^0.7.87",
    "polylabel": "^2.1.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "setup-skia-web && expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "maps": "node tools/maps/build.mjs europe && node tools/maps/build.mjs africa",
    "postinstall": "node tools/gen-assets.mjs",
    "assets": "node tools/gen-assets.mjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/*.test.ts?(x)"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  }
}
